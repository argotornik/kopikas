node_modules/
.next/
data/
.env*
.vercel/
brag-output*/

# TypeScript's incremental build cache.
*.tsbuildinfo

# Next.js rewrites this on every dev, build and typegen (it points at .next/dev or .next), and its
# docs say not to track it: next build makes it before type-checking.
/next-env.d.ts

# Impeccable's local question server: its process, port and heartbeat.
/.impeccable/questions/

# Impeccable's live server: its port, sessions and annotations from a detector run.
/.impeccable/live/

# The Figma kit's generated scenes, SVGs and scripts (scripts/figma-kit/README.md).
/scripts/figma-kit/out/
